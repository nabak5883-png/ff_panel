rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "user";
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.coins == resource.data.coins
        && request.resource.data.points == resource.data.points
        && request.resource.data.matches == resource.data.matches
        && request.resource.data.wins == resource.data.wins;
      allow delete: if false;
    }

    match /tournaments/{tournamentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /tournamentJoins/{joinId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }
  }
}
